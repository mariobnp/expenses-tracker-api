// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INCOME
  EXPENSE
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  username     String        @unique(map: "users_username_key") @db.VarChar(20)
  name         String        @db.VarChar(50)
  password     String        @map("password_hash") @db.VarChar(255)
  transactions Transaction[]
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model Category {
  id           String          @id @default(uuid()) @db.Uuid
  name         String          @db.VarChar(30)
  type         TransactionType
  transactions Transaction[]
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @map("updated_at") @db.Timestamptz(3)

  @@unique([name, type], map: "categories_name_type_key")
  @@unique([id, type], map: "categories_id_type_key")
  @@map("categories")
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  categoryId      String          @map("category_id") @db.Uuid
  type            TransactionType
  amount          Decimal         @db.Decimal(15, 2)
  transactionDate DateTime        @map("transaction_date") @db.Timestamptz(3)
  description     String?         @db.VarChar(500)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  category        Category        @relation(fields: [categoryId, type], references: [id, type], onDelete: Restrict)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId], map: "transactions_user_id_idx")
  @@index([userId, transactionDate], map: "transactions_user_id_transaction_date_idx")
  @@index([categoryId], map: "transactions_category_id_idx")
  @@map("transactions")
}
